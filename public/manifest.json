{
  "manifest_version": 3,
  "name": "MarginClip",
  "version": "0.1.0",
  "description": "Webページの横でMarkdownメモ。記事とメモ、画像をまとめてローカルに保存。",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "scripting", "tabs", "downloads", "unlimitedStorage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "MarginClipを開く", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "side_panel": { "default_path": "sidepanel.html" },
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+M" }, "description": "MarginClipを開く" } },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';" }
}
